<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Meet — Collab Workspace</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;650;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="stylesheet" href="styles.css?v=20260908m">
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🤝</text></svg>">
</head>
<body>
  <div class="app">
    <header class="topbar">
      <div class="brand">
        <span class="logo"><i class="fa-solid fa-handshake"></i></span>
        <h1>Meet</h1>
        <span id="meetingBadge" class="meeting-badge hidden"></span>
        <button id="copyCodeBtn" class="btn small-btn copy-top hidden" title="Copy meeting code">
          <i class="fa-regular fa-copy"></i>
        </button>
      </div>
      <div class="controls">
        <div id="authArea" class="auth-area">
          <button id="loginOpenBtn" class="btn small-btn">Log in</button>
          <button id="signupOpenBtn" class="btn small-btn primary-outline">Sign up</button>
        </div>
        <div id="userArea" class="user-area hidden">
          <span id="userLabel" class="user-label"></span>
          <button id="historyBtn" class="btn icon-btn desktop-only" title="Meeting history">
            <i class="fa-solid fa-clock-rotate-left"></i>
          </button>
          <button id="logoutBtn" class="btn small-btn desktop-only" title="Log out">Log out</button>
        </div>
        <button id="leaveBtn" class="btn leave-btn hidden" title="Leave meeting">
          <i class="fa-solid fa-right-from-bracket"></i>
          <span class="leave-label">Leave</span>
        </button>
        <button id="themeToggle" class="btn icon-btn desktop-only" title="Toggle day / night">
          <i class="fa-solid fa-moon"></i>
        </button>
        <button id="fullscreenBtn" class="btn icon-btn desktop-only" title="Toggle app fullscreen">
          <i class="fa-solid fa-expand"></i>
        </button>
        <div class="more-menu-wrap mobile-only">
          <button id="moreMenuBtn" class="btn icon-btn" title="More" aria-haspopup="true" aria-expanded="false">
            <i class="fa-solid fa-ellipsis-vertical"></i>
          </button>
          <div id="moreMenu" class="more-menu hidden" role="menu">
            <button type="button" class="more-item" data-action="theme" role="menuitem">
              <i class="fa-solid fa-moon"></i> Theme
            </button>
            <button type="button" class="more-item" data-action="fullscreen" role="menuitem">
              <i class="fa-solid fa-expand"></i> Fullscreen
            </button>
            <button type="button" class="more-item more-history hidden" data-action="history" role="menuitem">
              <i class="fa-solid fa-clock-rotate-left"></i> History
            </button>
            <button type="button" class="more-item more-logout hidden" data-action="logout" role="menuitem">
              <i class="fa-solid fa-right-from-bracket"></i> Log out
            </button>
            <button type="button" class="more-item more-login" data-action="login" role="menuitem">
              <i class="fa-solid fa-right-to-bracket"></i> Log in
            </button>
            <button type="button" class="more-item more-signup" data-action="signup" role="menuitem">
              <i class="fa-solid fa-user-plus"></i> Sign up
            </button>
          </div>
        </div>
      </div>
    </header>

    <!-- HOME -->
    <section id="homeView" class="home-view">
      <div class="landing-shell">
        <div class="landing-hero">
          <div class="hero-copy anim-enter" style="--delay:0s">
            <div class="landing-eyebrow">
              <span class="eyebrow-dot"></span>
              <span>COLLABORATIVE MEETINGS</span>
            </div>
            <h2>Meet, share, and <span class="hero-gradient">get things done.</span></h2>
            <p class="home-sub">A focused meeting space for real conversations, screen sharing, and teamwork — without the clutter.</p>

            <div class="hero-pills" aria-label="Meet features">
              <span><i class="fa-solid fa-bolt"></i> Fast to join</span>
              <span><i class="fa-solid fa-desktop"></i> Screen sharing</span>
              <span><i class="fa-solid fa-shield-halved"></i> Private rooms</span>
            </div>
          </div>

          <div class="hero-stage anim-enter-scale" style="--delay:.15s" aria-hidden="true">
            <div class="stage-glow"></div>
            <div class="stage-window">
              <div class="stage-topbar">
                <div class="stage-dots"><i></i><i></i><i></i></div>
                <span>meet / project-sync</span>
                <b><span class="stage-live-dot"></span> LIVE</b>
              </div>
              <div class="stage-body">
                <div class="stage-sidebar">
                  <span class="stage-label">PEOPLE</span>
                  <div class="stage-person"><span class="stage-avatar avatar-one">J</span><span>Jidenna</span><em>Host</em></div>
                  <div class="stage-person"><span class="stage-avatar avatar-two">A</span><span>Alex</span></div>
                  <div class="stage-person"><span class="stage-avatar avatar-three">M</span><span>Maya</span></div>
                </div>
                <div class="stage-screen">
                  <div class="screen-header"><span>Weekly review meeting</span></div>
                  <div class="my-mock-editor">
                    <div class="my-mock-card">
                      <img class="my-mock-thumb" src="images/small-left.jpg" alt="" loading="lazy">
                      <img class="my-mock-thumb" src="images/small-center.jpg" alt="" loading="lazy">
                      <img class="my-mock-thumb" src="images/small-right.jpg" alt="" loading="lazy">
                    </div>
                    <div class="chat-thread" aria-hidden="true">
                      <div class="chat-msg msg-1">
                        <span class="chat-who">Jidenna</span>
                        <p class="type-line" data-text="Can everyone see the board?"></p>
                      </div>
                      <div class="chat-msg msg-2">
                        <span class="chat-who">Alex</span>
                        <p class="type-line" data-text="Yep — looks clear on my end."></p>
                      </div>
                      <div class="chat-msg msg-3">
                        <span class="chat-who">Maya</span>
                        <p class="type-line" data-text="Sharing the latest mock now…"></p>
                      </div>
                    </div>
                  </div>
                  <div class="stage-cursor"><i class="fa-solid fa-arrow-pointer"></i><span>Maya</span></div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="landing-intent anim-enter" style="--delay:.25s">
          <div>
            <span class="section-kicker">START IN SECONDS</span>
            <h3>What do you want to do?</h3>
            <p>Create a room for your team or jump straight into one you've been invited to.</p>
          </div>
          <div class="intent-line"><span></span><i class="fa-solid fa-arrow-down"></i></div>
        </div>

        <div class="home-cards landing-meeting-cards">
          <!-- Create card -->
          <div class="home-card create-card landing-action-card anim-enter" style="--delay:.35s">
            <div class="card-image">
              <img src="images/create-meeting.webp" alt="Create a new meeting" width="640" height="360" loading="lazy">
              <span class="image-badge"><i class="fa-solid fa-sparkles"></i> New room</span>
            </div>
            <div class="card-body">
              <div class="card-heading-row">
                <div class="card-icon-large"><i class="fa-solid fa-plus"></i></div>
                <div><h3>Create a meeting</h3><span>Start a fresh room</span></div>
              </div>
              <div class="form-block">
                <input id="createName" type="text" maxlength="60" placeholder="Meeting name (e.g. Design review)" autocomplete="off" aria-label="Meeting name">
                <input id="createYourName" type="text" maxlength="40" placeholder="Your name" autocomplete="off" aria-label="Your name">
                <button id="createBtn" class="btn primary-btn landing-main-btn">
                  <span>Create meeting</span><i class="fa-solid fa-arrow-right"></i>
                </button>
                <p id="createError" class="error-msg hidden"></p>
              </div>
            </div>
          </div>

          <!-- Join card -->
          <div class="home-card join-card landing-action-card anim-enter" style="--delay:.5s">
            <div class="card-image">
              <img src="images/join-meeting.webp" alt="Join an existing meeting" width="640" height="360" loading="lazy">
              <span class="image-badge"><i class="fa-solid fa-arrow-right-to-bracket"></i> Join a room</span>
            </div>
            <div class="card-body">
              <div class="card-heading-row">
                <div class="card-icon-large secondary"><i class="fa-solid fa-arrow-right-to-bracket"></i></div>
                <div><h3>Join a meeting</h3><span>Enter your room code</span></div>
              </div>
              <div class="form-block">
                <div class="code-inputs">
                  <input id="joinLetters" type="text" maxlength="3" placeholder="ABC" autocomplete="off" spellcheck="false" aria-label="Meeting code letters">
                  <span class="code-sep">—</span>
                  <input id="joinNumbers" type="text" maxlength="3" placeholder="123" inputmode="numeric" autocomplete="off" aria-label="Meeting code numbers">
                </div>
                <input id="joinYourName" type="text" maxlength="40" placeholder="Your name" autocomplete="off" aria-label="Your name">
                <button id="joinBtn" class="btn primary-btn landing-main-btn">
                  <span>Join meeting</span><i class="fa-solid fa-arrow-right"></i>
                </button>
                <p id="joinError" class="error-msg hidden"></p>
              </div>
            </div>
          </div>
        </div>

        <div class="landing-trust-row anim-enter" style="--delay:.65s">
          <div class="trust-item"><strong>01</strong><span>Open a room</span></div>
          <div class="trust-line"></div>
          <div class="trust-item"><strong>02</strong><span>Invite your people</span></div>
          <div class="trust-line"></div>
          <div class="trust-item"><strong>03</strong><span>Share & collaborate</span></div>
        </div>

        <section class="landing-benefits anim-enter" style="--delay:.8s">
          <div class="benefit-copy">
            <span class="section-kicker">BUILT FOR FOCUS</span>
            <h3>Everything you need to make a meeting feel effortless.</h3>
            <p>Keep the experience simple: enter a room, see who's there, share your screen, and talk. Your existing meeting tools stay exactly where you expect them.</p>
          </div>
          <div class="benefit-grid">
            <article><span><i class="fa-solid fa-users"></i></span><h4>People, at a glance</h4><p>See who's in the room and who is sharing.</p></article>
            <article><span><i class="fa-solid fa-desktop"></i></span><h4>Share your screen</h4><p>Present work directly inside the meeting.</p></article>
            <article><span><i class="fa-solid fa-clock-rotate-left"></i></span><h4>Meeting history</h4><p>Signed-in users can revisit their meeting history.</p></article>
          </div>
        </section>

        <div class="landing-bottom-cta anim-enter" style="--delay:.95s">
          <div class="cta-mark"><i class="fa-solid fa-handshake"></i></div>
          <div><strong>Ready when your team is.</strong><span>Create a room and start the conversation.</span></div>
          <button class="btn landing-ghost-btn" type="button" onclick="document.getElementById('createName')?.focus()">Start a meeting <i class="fa-solid fa-arrow-right"></i></button>
        </div>
      </div>
    </section>

    <!-- HISTORY -->
    <section id="historyView" class="history-view hidden">
      <div class="history-card">
        <div class="history-header">
          <h2><i class="fa-solid fa-clock-rotate-left"></i> Meeting history</h2>
          <button id="historyCloseBtn" class="btn small-btn">Back</button>
        </div>
        <p id="historyEmpty" class="history-empty hidden">No meetings yet. Create or join one while logged in.</p>
        <ul id="historyList" class="history-list"></ul>
        <div id="historyDetail" class="history-detail hidden">
          <h3 id="historyDetailTitle"></h3>
          <p id="historyDetailMeta" class="history-meta"></p>
          <h4>Participants</h4>
          <ul id="historyDetailParticipants" class="history-participants"></ul>
          <button id="historyDetailBack" class="btn small-btn">Back to list</button>
        </div>
      </div>
    </section>

    <!-- MEETING -->
    <main id="meetingView" class="layout hidden">
      <section class="col col-1" id="col1">
        <div class="panel people-panel">
          <h2>
            <i class="fa-solid fa-users"></i>
            People
            <span id="participantCount" class="count-badge">1</span>
          </h2>
          <div class="content">
            <ul class="participant-list" id="participantList"></ul>
          </div>
        </div>
      </section>

      <div class="resizer" id="resizer" title="Drag to resize"></div>

      <section class="col col-2" id="col2">
        <div class="panel">
          <div class="content meeting-content">
            <div class="screen-cards" id="screenCards"></div>
            <div class="big-view" id="bigView">
              <video id="remoteVideo" autoplay playsinline></video>
              <div id="bigPlaceholder" class="placeholder">
                <i class="fa-solid fa-desktop big-icon"></i>
                <p>No screen selected</p>
                <p class="sub">Click a LIVE card to watch, or share your own</p>
              </div>
              <div class="big-view-label" id="bigViewLabel"></div>
              <button id="screenFsBtn" class="btn icon-btn screen-fs-btn" title="Fullscreen shared screen">
                <i class="fa-solid fa-expand"></i>
              </button>
            </div>
            <div class="call-controls">
              <button id="shareBtn" class="btn call-btn" title="Share your screen">
                <i class="fa-solid fa-desktop"></i>
                <span>Share screen</span>
              </button>
              <button id="micBtn" class="btn call-btn" title="Toggle microphone">
                <i class="fa-solid fa-microphone"></i>
                <span>Mic</span>
              </button>
              <div id="liveStatus" class="live-status" aria-live="polite">
                <span class="live-status-dot"></span>
                <span id="liveStatusText" class="live-status-text">Connecting…</span>
              </div>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer class="footer">
      <span>Meet · LiveKit media</span>
    </footer>
  </div>

  <!-- Auth modal -->
  <div id="authModal" class="modal hidden">
    <div class="modal-backdrop" id="authModalBackdrop"></div>
    <div class="modal-card">
      <button class="modal-close" id="authModalClose" title="Close">&times;</button>
      <div class="auth-tabs">
        <button id="tabLogin" class="auth-tab active">Log in</button>
        <button id="tabSignup" class="auth-tab">Sign up</button>
      </div>

      <form id="loginForm" class="auth-form">
        <label for="loginIdentity">Email</label>
        <input id="loginIdentity" type="text" autocomplete="username" required>
        <label for="loginPassword">Password</label>
        <input id="loginPassword" type="password" autocomplete="current-password" required>
        <button type="submit" class="btn primary-btn full-width">Log in</button>
        <p id="loginError" class="error-msg hidden"></p>
      </form>

      <form id="signupForm" class="auth-form hidden">
        <label for="signupUsername">Username</label>
        <input id="signupUsername" type="text" maxlength="24" autocomplete="username" required>
        <label for="signupEmail">Email</label>
        <input id="signupEmail" type="email" autocomplete="email" required>
        <label for="signupPassword">Password (min 6)</label>
        <input id="signupPassword" type="password" autocomplete="new-password" minlength="6" required>
        <button type="submit" class="btn primary-btn full-width">Create account</button>
        <p id="signupError" class="error-msg hidden"></p>
      </form>
    </div>
  </div>

  <!-- Display name required before joining (including join links) -->
  <div id="nameModal" class="modal hidden">
    <div class="modal-backdrop" id="nameModalBackdrop"></div>
    <div class="modal-card name-modal-card">
      <h2 class="name-modal-title">What’s your name?</h2>
      <p class="name-modal-sub">Enter a display name so others know who’s in the meeting.</p>
      <form id="nameForm" class="auth-form">
        <input id="nameModalInput" type="text" maxlength="40" placeholder="Your name" autocomplete="name" required autofocus>
        <button type="submit" class="btn primary-btn full-width">Join meeting</button>
        <p id="nameModalError" class="error-msg hidden"></p>
      </form>
      <button type="button" id="nameModalCancel" class="btn small-btn name-modal-cancel">Cancel</button>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/livekit-client@2.9.1/dist/livekit-client.umd.min.js"></script>
  <script src="script.js?v=20260908m"></script>
</body>
</html>
